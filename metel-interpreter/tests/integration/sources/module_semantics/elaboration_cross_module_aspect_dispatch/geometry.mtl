// Aspect and struct defined in a dependency module.
// The elaboration pass must resolve method dispatch using the declaring module's SymbolId.

public aspect Describable {
    fun describe(self) -> String;
}

public aspect Scalable {
    fun scale(self, factor: i64) -> i64;
}

public struct Circle { public radius: i64 }
public struct Rectangle { public width: i64, public height: i64 }

extend Circle: Describable {
    fun describe(self) -> String {
        "Circle(r=" + self.radius.to_string() + ")"
    }
}

extend Rectangle: Describable {
    fun describe(self) -> String {
        "Rect(" + self.width.to_string() + "x" + self.height.to_string() + ")"
    }
}

extend Circle: Scalable {
    fun scale(self, factor: i64) -> i64 { self.radius * factor }
}

extend Rectangle: Scalable {
    fun scale(self, factor: i64) -> i64 { self.width * self.height * factor }
}
