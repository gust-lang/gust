// A binary operator whose operands disagree now names the operator, in the form
// `error-codes.md` documents for T0005. Previously every one of these produced a bare
// `cannot unify X with Y` (T0001) that said the two types disagreed but never said a
// comparison or arithmetic operator was what required them to agree.
fun main() {
    let b := 1 - true; // ERROR[T0005]
}
