// Cross-module test: module1 with pub function returning impl Aspect

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

impl Display for MyInt {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

pub fun make_public_int() -> impl Display {
	MyInt { value: 42 }
}