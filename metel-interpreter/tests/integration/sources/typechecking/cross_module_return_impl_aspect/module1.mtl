// Cross-module test: module1 with public function returning impl Aspect

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

extend MyInt: Display {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

public fun make_public_int() -> impl Display {
	MyInt { value: 42 }
}