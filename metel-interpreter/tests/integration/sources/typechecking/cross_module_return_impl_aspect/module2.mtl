// Cross-module test: module2 provides its own public fun returning impl Aspect

aspect Display {
	fun display(&self) -> String;
}

struct MyString {
	value: String,
}

extend MyString: Display {
	fun display(self) -> String {
		self.value
	}
}

public fun make_string() -> impl Display {
	MyString { value: "hello".to_string() }
}