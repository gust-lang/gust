// Negative (RFC-0116 §3): an anonymous record has no nominal owner, so it satisfies no
// impl-based aspect. It must be rejected at the call site, like a tuple or a struct
// without the impl — not accepted and then blown up at run time.
fun show<T: Display>(x: T) -> String { x.to_string() }

fun main() {
    let r := { x = 1 };
    let s := show(r);
}
