// The assumption set an impl's own generics contribute (issue #303) is
// exactly its positive bounds — an unbounded parameter contributes nothing.
//
// This guards the direction that would be dangerous to get wrong: `T` must
// answer `false` for `Copy` here, rather than falling through to whatever an
// unrelated declaration named `T` might satisfy, or being treated as
// unknown-therefore-fine.

struct Outer<T> {
    value: T,
}

extend<T> Outer<T>: Copy;

fun main() {}
