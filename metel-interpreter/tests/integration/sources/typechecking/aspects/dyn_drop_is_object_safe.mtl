// Regression (metel-core#865, RFC-0008 slice 1, §3's "Standard library
// object-safety" list): `std::core::Drop` is object-safe by the ordinary
// rule -- its one method, `fun drop(&var self);`, takes an ordinary `&var
// Self` receiver (RFC-0071, revised 2026-08-27; was `self` by value, which
// would have needed a dedicated rule-1 exception here -- see that revision's
// note for why).

fun a(x: dyn Drop) -> i64 { 0 }

fun main() {}
