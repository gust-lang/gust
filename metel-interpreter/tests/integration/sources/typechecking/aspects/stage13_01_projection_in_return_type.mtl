// RFC-0082 SS3: `T::AssocType` in return-type position, where T is a bound generic
// parameter, is recognized as a projection (not a plain dotted name) and typechecks
// -- this declaration-only fixture never calls `peek`, so it doesn't exercise real
// call-site resolution to a concrete type; see
// evaluator/aspects/74_projection_call_site_resolution.mtl for that (issue #242).

aspect Container {
    type Item;
}

fun peek<T: Container>(x: &T) -> T::Item {
    return panic("not needed for this fixture");
}

fun main() {
    assert(1 == 1);
}
