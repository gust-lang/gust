// §3.2: unconditional impl + conditional impl for the same aspect/type
// constructor → T0015 conflict. The unconditional impl has all-empty scoped
// bounds, so provably_disjoint can never return true against it.

aspect Display {
    fun display(self) -> String;
}

aspect Printable {
    fun print(self) -> String;
}

struct Pair<A, B> {
    first: A,
    second: B,
}

// Unconditional blanket impl — no bounds, scoped bounds are all-empty.
impl<A, B> Printable for Pair<A, B> {
    fun print(self) -> String { return "unconditional"; }
}

// Conditional impl — Display bound at position 0.
impl<C: Display> Printable for Pair<C, C> { // ERROR[T0015]
    fun print(self) -> String { return "conditional"; }
}

fun main() {}
