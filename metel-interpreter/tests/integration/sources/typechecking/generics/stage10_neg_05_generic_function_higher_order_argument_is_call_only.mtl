// Negative: #736 -- the same call-only restriction applies to a generic function
// named directly in a higher-order-argument position, not just a `let` binding.
// `apply` itself being non-generic here isolates the case: the failure is about
// `identity` being unreferenceable as a value, not about `apply`'s own generics.

fun identity<T>(x: T) -> T { return x; }
fun apply(f: (i64) -> i64, x: i64) -> i64 { return f(x); }

fun main() {
    apply(identity, 3); // ERROR[T0003]
}
