// Positive: `extends Aspect` in parameter position desugars to a fresh type param.

aspect Printable {
    fun print(self);
}

struct Label {
    text: String,
}

extend Label: Printable {
    fun print(self) {}
}

fun print_it(x: extends Printable) {
    x.print()
}

fun run(label: Label) {
    print_it(label)
}
