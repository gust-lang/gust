// Positive: extends Aspect param coexists with a where clause on a named type param.
// Both are enforced independently.

aspect Printable {
    fun print(self);
}

aspect Serializable {
    fun serialize(self) -> String;
}

struct A { value: i64 }
struct B { name: String }

extend A: Printable { fun print(self) {} }
extend B: Serializable {
    fun serialize(self) -> String { self.name }
}

fun process<U>(x: extends Printable, y: U) -> String where U: Serializable {
    x.print();
    y.serialize()
}

fun run(a: A, b: B) -> String {
    process(a, b)
}
