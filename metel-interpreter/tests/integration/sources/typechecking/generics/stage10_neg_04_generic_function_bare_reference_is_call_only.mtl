// Negative: #736 -- a generic function has no value form yet (RFC-0138 proposes
// lifting this). A bare reference is rejected, but with a diagnostic that says
// what's actually true (the name exists, it just can't be referenced this way)
// rather than a misleading `undefined name`.

fun identity<T>(x: T) -> T { return x; }

fun main() {
    let alias = identity; // ERROR[T0003]
}
