// Positive: function with both inline + bound and where clause bound on the same
// param. Both must be satisfied at the call site.

aspect Printable {
    fun print(self);
}

aspect Comparable {
    fun compare(self, other: Self) -> i64;
}

struct Entry {
    value: i64,
}

extend Entry: Printable {
    fun print(self) {}
}

extend Entry: Comparable {
    fun compare(self, other: Entry) -> i64 {
        self.value - other.value
    }
}

fun process<T: Printable>(x: T) where T: Comparable {
    x.print()
}

fun run(e: Entry) {
    process(e)
}
