// std::core Perhaps<T> and Result<T, E> ergonomic methods (METEL-159).
// Pure-Metel methods defined on the core sum types, auto-imported via std::core.

fun main() {
    // ── Perhaps ──────────────────────────────────────────────────────────────
    let some = Perhaps::Some { value = 21 };
    let none: Perhaps<i64> = Perhaps::None;

    assert(some.is_some());
    assert(!some.is_none());
    assert(none.is_none());
    assert(!none.is_some());

    // map transforms Some, passes through None
    assert(some.map((x: i64) -> i64 { x * 2 }).unwrap_or(0) == 42);
    assert(none.map((x: i64) -> i64 { x * 2 }).unwrap_or(-1) == -1);
    // map may change the element type
    assert(some.map((x: i64) -> String { "v" }).unwrap_or("none") == "v");

    // and_then chains a Perhaps-returning function
    assert(some.and_then((x: i64) -> Perhaps<i64> { Perhaps::Some { value = x + 1 } }).unwrap_or(0) == 22);
    assert(some.and_then((x: i64) -> Perhaps<i64> { Perhaps::None }).is_none());

    // unwrap_or / unwrap_or_else
    assert(some.unwrap_or(0) == 21);
    assert(none.unwrap_or(7) == 7);
    assert(none.unwrap_or_else(() -> i64 { 9 }) == 9);
    assert(some.unwrap_or_else(() -> i64 { 9 }) == 21);

    // ── Result ───────────────────────────────────────────────────────────────
    let ok: Result<i64, String> = Result::Ok { value = 10 };
    let err: Result<i64, String> = Result::Err { error = "boom" };

    assert(ok.is_ok());
    assert(!ok.is_err());
    assert(err.is_err());
    assert(!err.is_ok());

    assert(ok.map((x: i64) -> i64 { x + 5 }).unwrap_or(0) == 15);
    assert(err.map((x: i64) -> i64 { x + 5 }).unwrap_or(99) == 99);
    // map preserves the Err payload
    assert(err.map((x: i64) -> i64 { x + 5 }).is_err());

    assert(ok.and_then((x: i64) -> Result<i64, String> { Result::Ok { value = x * 3 } }).unwrap_or(0) == 30);
    assert(ok.and_then((x: i64) -> Result<i64, String> { Result::Err { error = "no" } }).is_err());

    assert(ok.unwrap_or(0) == 10);
    assert(err.unwrap_or(3) == 3);
    assert(err.unwrap_or_else(() -> i64 { 4 }) == 4);

    println("ok");
}
