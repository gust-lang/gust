// A module's overload set EXTENDS an outer binding of the same name:
// exact-match candidates win; otherwise the call falls back to the
// non-overload binding (here, std::core's generic print<T>).

fun print(x: i32) {
    println("i32: ${x}");
}

fun print(x: i64) {
    println("i64: ${x}");
}

fun main() {
    print(1i32); // local overload
    print(2i64); // local overload
    print(3i8);  // no exact match -> falls back to std::core print<T>
    println("");
    println("ok");
}
