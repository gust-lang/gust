// RFC-0137 slice 2 (metel-core#858): moving a non-`Copy` field out of a struct
// narrows the value's *type* to a residual of the same brand -- `Handle` becomes
// `Handle.{ fd }` -- and that residual is exactly the one an explicit projection
// `h.{ fd }` produces, so the two are interchangeable at a `Self.{ fd }`
// parameter (spec.ownership.narrowing.dynamics-1). The residual keeps every
// still-present field usable.

struct Handle { fd: i64, name: String }

extend Handle {
    fun describe(h: Self.{ fd }) -> i64 { h.fd }
}

fun main() {
    // Route A: a partial move narrows `h` in place.
    let h := Handle { fd = 7, name = "a" };
    let taken := h.name;                 // h : Handle.{ fd } from here on
    assert(h.fd == 7);                   // the sibling field stays readable
    assert(Handle::describe(h) == 7);    // the narrowed value fits `Self.{ fd }`

    // Route B: an explicit projection produces the same residual type.
    let h2 := Handle { fd = 7, name = "b" };
    assert(Handle::describe(h2.{ fd }) == 7);

    // Re-projecting an already-narrowed residual is fine for a field it still has.
    assert(Handle::describe(h.{ fd }) == 7);

    println(taken);
}
