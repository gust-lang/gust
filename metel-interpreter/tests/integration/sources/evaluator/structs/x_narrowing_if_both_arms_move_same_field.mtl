// v0.13.0 cross-feature (integration session, metel-core#956): row narrowing
// (RFC-0117) across `if` / `match` arms. Each arm should start from the
// pre-construct move state and the binding should be the join of the arms
// afterward. It is NOT -- the typechecker runs both arms against one shared
// FlowState, so the `else` arm sees the `then` arm's move of `rec.drop1`.
// Tracked as metel-core#958; unskip when the fork/join lands.
fun main() {
    let cond := true;
    let rec := { drop1 = "a".to_string(), keep = 3 };
    if (cond) {
        let g := rec.drop1;
    } else {
        let g := rec.drop1;          // independent path -- a fresh move, not "already moved"
    }
    assert(rec.keep == 3);           // rec : { keep: i64 } after the join
    println("ok");
}
