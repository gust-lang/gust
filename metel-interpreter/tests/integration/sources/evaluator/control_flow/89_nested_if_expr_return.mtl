// Issue #229: `return` reachable in a nested expression position, not just
// tail/statement position -- an `if` used as the value of a `let`, where one
// branch is `return`.
fun f(c: boolean) -> i64 {
    let x := if (c) return 99 else 0;
    x
}

fun main() {
    assert(f(true) == 99);
    assert(f(false) == 0);
}
