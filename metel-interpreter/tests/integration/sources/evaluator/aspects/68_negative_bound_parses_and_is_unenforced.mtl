// RFC-0072: `T: !Drop`-style negative bounds parse and mix with positive bounds.
// Issue #233's scope is representation only — satisfaction checking (rejecting a
// T that DOES implement the negated aspect) is issue #243's job, not this one's.
// This fixture is enforced since #243 landed; it passes because `i64` has no
// registered `Drop` impl, so the negative bound is satisfied.

fun move_out<T: !Drop>(x: T) -> T {
    return x;
}

fun mixed<T: Display + !Drop>(x: T) -> T {
    return x;
}

fun main() {
    assert(move_out(5) == 5);
    assert(mixed(7) == 7);
}
