// TYPECHECK_ERROR[conflicting implementation]
// RFC-0081 SS2.2, issue #264: a negative impl is final -- no positive impl may
// coexist with a negative impl for the same type and aspect. This falls out
// of the existing overlap check (issue #238/RFC-0060), which doesn't special-
// case polarity: two impls of the same aspect for the same concrete type
// already collide regardless of polarity. Locked in here as its own fixture
// since it was never explicitly exercised before this issue.

aspect Greet {
    fun greet(&self) -> String;
}

struct Widget {
    x: i64,
}

extend Widget: Greet {
    fun greet(&self) -> String {
        return "hi";
    }
}

extend Widget: !Greet;

fun main() {}
