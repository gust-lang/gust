// v0.13.0 closure cluster (RFC-0050 legality-7): once a capture list is
// present it must be exhaustive -- every free local the body references must
// appear, even `Copy` ones. Module-level items are never capture items.
//
// DRAFT FIXTURE -- written against the RFC text ahead of implementation
// (metel-core#926). Not runnable yet: see the `skip` reason in the sidecar.
// Intended once live: spec = ["spec.functions.closures.legality-7"]
fun main() {
    let a := 1;
    let b := 2;
    let f := [a] () -> i64 { a + b }; // `b` referenced but missing from the list
    f();
}
