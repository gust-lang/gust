// v0.13.0 closure cluster (RFC 0050 legality-7): once a capture list is
// present it must be exhaustive -- every free local the body references must
// appear, even `Copy` ones. Module-level items are never capture items.
//
fun main() {
    let a := 1;
    let b := 2;
    let f := [a] || { a + b }; // `b` referenced but missing from the list
    f();
}
