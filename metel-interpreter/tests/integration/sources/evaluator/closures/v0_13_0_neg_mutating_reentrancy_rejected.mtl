// v0.13.0 closure cluster (RFC 0153 dynamics-9): for the extent of a
// `mutating` call the callee is exclusively borrowed. A second `mutating`
// call on the same closure value reached from inside the first is rejected --
// before the borrow checker lands, as a runtime error (R0007).
//
// DRAFT FIXTURE -- written against the RFC text ahead of implementation
// (metel-core#929). Not runnable yet: see the `skip` reason in the sidecar.
// Intended once live: spec = ["spec.functions.closures.dynamics-9"]
struct Cell {
    go: var () -> i64,
}

fun main() {
    var c := Cell { go = () -> i64 { 0 } };
    c.go := [&var c] var () -> i64 {
        (c.go)() + 1 // re-enters the same `var` closure while its first call is live
    };
    (c.go)(); // runtime error R0007 -- re-entrant call to a mutating closure
}
