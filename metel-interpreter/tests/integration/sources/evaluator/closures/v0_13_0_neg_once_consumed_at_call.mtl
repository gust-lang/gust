// v0.13.0 closure cluster (RFC 0134 dynamics-10): a `once` call consumes the
// callee place at the call expression; a second call is the ordinary
// moved-value error.
//
// Needs move_check = true (general moved-value check, RFC 0071).
fun main() {
    let s := "hello";
    let take := [s] once || -> String { s };
    let first := take();
    let second := take(); // moved-value error -- `take` was already consumed
}
