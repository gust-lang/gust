// v0.13.0 closure cluster (RFC 0134 legality-18): an unqualified closure
// literal in a typed position takes its `once` / `var` from the expected
// type rather than defaulting to `many` / `reading` and then failing.
//
fun make(s: String) -> once || -> String {
    [s] || { s } // no `once` written; the return type supplies it
}

fun main() {
    let f := make("hi");
    assert(f() == "hi");
}
