// v0.13.0 closure cluster (RFC 0050 legality-5): a capture list holds all four
// specifier forms -- `&var ident`, `&ident`, `ident` (bare), `ident.clone()`.
//
fun main() {
    var count := 0;
    let cfg := 10;
    let tag := 42;
    let name := "log";
    var handler := [&var count, &cfg, tag, name.clone()] var (req: i64) -> i64 {
        count += 1;
        req + cfg + tag
    };
    assert(handler(1) == 53);
    assert(count == 1);
    assert(name == "log"); // outer `name` still usable -- `[name.clone()]` didn't move it
}
