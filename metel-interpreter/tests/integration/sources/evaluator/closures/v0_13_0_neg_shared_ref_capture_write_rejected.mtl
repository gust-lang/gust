// v0.13.0 closure cluster (RFC 0050 legality-21): a `[&x]` capture is
// read-only. A body that writes through it is a compile error at the
// capture, not a silent upgrade to `mutating`.
//
fun main() {
    var count := 0;
    let bump := [&count] || {
        count += 1; // error: `count` is captured by shared reference, not `&var`
    };
    bump();
}
