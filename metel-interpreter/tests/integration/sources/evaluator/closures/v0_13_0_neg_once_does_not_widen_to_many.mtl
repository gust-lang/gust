// v0.13.0 closure cluster (RFC-0152 legality-9): widening is one-directional
// -- a `once` function value may NOT be used where a `many` slot is
// expected; the reverse of legality-9 is the ordinary type mismatch.
//
// DRAFT FIXTURE -- written against the RFC text ahead of implementation
// (metel-core#928). Not runnable yet: see the `skip` reason in the sidecar.
// Intended once live: spec = ["spec.functions.closures.legality-9"]
fun call_many(f: () -> String) -> String {
    f() + f() // calls twice -- needs `many`
}

fun main() {
    let s := "hello";
    let once_closure := [s] once () -> String { s }; // returns `s`, moving it out -- correctly `once`
    call_many(once_closure); // error: `once` does not widen to a `many` slot
}
