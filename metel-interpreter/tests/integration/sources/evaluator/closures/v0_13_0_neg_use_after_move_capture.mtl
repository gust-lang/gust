// v0.13.0 closure cluster (RFC 0157 D5): `[s]` moves a non-Copy binding into
// the closure, consuming the outer binding. Using it afterward is the
// ordinary moved-value error (RFC 0134 §2 cites T0019's existing shape).
//
// Needs move_check = true: this is the general affine-move check (RFC 0071),
// not one of the closure-specific always-on checks (ADR-0052 §1).
fun main() {
    let s := "hello";
    let greet := [s] once || -> String { s };
    println(s); // moved-value error -- `s` was moved into `greet`
}
