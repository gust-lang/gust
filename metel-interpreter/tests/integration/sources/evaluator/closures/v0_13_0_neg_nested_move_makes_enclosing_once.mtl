// v0.13.0 closure cluster (RFC 0050 legality-22): evaluating an inner closure
// literal performs the capture, so an inner `[s]` that moves an
// enclosing-held `s` makes the *enclosing* closure `once` -- even though the
// inner is only constructed, never called. Calling the enclosing closure
// twice is then the ordinary moved-value error.
//
// DRAFT FIXTURE -- written against the RFC text ahead of implementation
// (metel-core#926). Not runnable yet: see the `skip` reason in the sidecar.
// Needs move_check = true (general moved-value check, RFC 0071).
// Intended once live: spec = ["spec.functions.closures.legality-22"]
fun main() {
    let s := "data";
    let outer := [s] once () -> once () -> String {
        let inner := [s] once () -> String { s }; // moves enclosing-held `s`; `outer` is declared `once`
        inner
    };
    let a := outer();
    let b := outer(); // moved-value error -- `outer` was consumed by the first call
}
