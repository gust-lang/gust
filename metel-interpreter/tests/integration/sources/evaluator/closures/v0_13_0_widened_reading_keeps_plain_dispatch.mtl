// v0.13.0 closure cluster (RFC 0152 dynamics-12): widening is type-level
// only. A `reading` closure widened into a `var` slot keeps its plain call
// path -- no exclusive borrow, no in-call flag -- because call lowering
// branches on the value's own mutation axis, not the slot type. So calling it
// twice from inside a `var`-typed parameter is fine.
//
fun call_mut(f: var () -> i64) -> i64 {
    f() + f()
}

fun main() {
    let pure := () -> i64 { 7 }; // `reading`, `many`
    assert(call_mut(pure) == 14); // widens into the `var` slot, still dispatched plainly
}
