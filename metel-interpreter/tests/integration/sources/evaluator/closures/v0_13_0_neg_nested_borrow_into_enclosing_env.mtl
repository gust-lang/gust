// v0.13.0 closure cluster (RFC 0050 legality-11): an inner closure may not
// capture, by `&` or `&var`, a binding that is a by-value capture of an
// enclosing closure. Interim rejection -- lifted when the borrow checker
// (RFC 0122) lands.
//
fun main() {
    let s := "data";
    let outer := [s] || -> boolean {
        let inner := [&s] || -> boolean { s == "data" }; // `&` into the enclosing closure's env
        inner()
    };
    outer();
}
