fun countdown<T>(n: i64, value: T) -> T {
    if (n == 0) {
        value
    } else {
        countdown(n - 1, value)
    }
}

fun bounce<T>(n: i64, _value: T) -> i64 {
    if (n == 0) {
        0
    } else {
        bounce(n - 1, 0)
    }
}

fun main() {
    assert(countdown(3, 42) == 42);
    assert(countdown(2, "metel") == "metel");
    assert(bounce(4, true) == 0);
}
