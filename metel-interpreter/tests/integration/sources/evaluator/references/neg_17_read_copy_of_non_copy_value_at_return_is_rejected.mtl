// TYPECHECK_ERROR[T0024]
// #649: mirrors `01_read_copy_at_return.mtl`, but for a non-`Copy` type -- a
// reference cannot be returned as its non-`Copy` referent type.
struct NotCopy { v: String }

fun f(r: &NotCopy) -> NotCopy {
    return r;
}

fun main() {
    let owned := NotCopy { v = "x" };
    let _ := f(&owned);
}
