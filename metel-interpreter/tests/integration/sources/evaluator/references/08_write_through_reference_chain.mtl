// RFC-0067a: write-through peels every `&var` layer of a chain, matching
// read-copy's own chain handling for the same auto-deref guarantee.
fun main() {
    var n = 1;
    var p: &var i64 = &var n;
    let pp: &var &var i64 = &var p;

    pp = 5;
    assert(n == 5);

    pp += 10;
    assert(n == 15);
}
