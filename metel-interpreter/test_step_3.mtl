// Test for return-position impl Aspect basic functionality (Step 3)
// This should typecheck but method calls may still fail until Step 4

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

impl Display for MyInt {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

fn make_pair() -> impl Display {
	MyInt { value: 42 }
}

fn main() {
	let pair = make_pair();
	// Method calls should fail until Step 4
	// let s = pair.display();
	// println!("{}", s);
}