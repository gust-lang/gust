    native(@std.core.f64_from) fun from(x: i64) -> f64;
}

impl From<u8> for f64 {
    native(@std.core.f64_from) fun from(x: u8) -> f64;
}

impl From<u16> for f64 {
    native(@std.core.f64_from) fun from(x: u16) -> f64;
}

impl From<u32> for f64 {
    native(@std.core.f64_from) fun from(x: u32) -> f64;
}

impl From<u64> for f64 {
    native(@std.core.f64_from) fun from(x: u64) -> f64;
}

impl From<f32> for f64 {
    native(@std.core.f64_from) fun from(x: f32) -> f64;
}

// ── Char ↔ u32 (Unicode code point) conversions ────────────────────────────

impl From<Char> for u32 {
    native(@std.core.u32_from) fun from(x: Char) -> u32;
}

impl From<u32> for Char {
    // Panics (R0009) when the code point is not a valid Unicode scalar.
    native(@std.core.char_from) fun from(x: u32) -> Char;
}
