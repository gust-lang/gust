// std::core — the always-available standard library prelude (METEL-181).
//
// This module is compiled into the interpreter binary (see build.rs) and loaded
// as a real module ahead of user code. It is the single source of truth for the
// core surface: the typechecker registry, the prelude, and the runtime all
// derive from this file (via stdlib::core_program()).
//
// Host-backed items use `native(@std.core.<id>)`, binding to a Rust host
// implementation selected by NativeKey. Everything else is ordinary Metel.
//
// String methods (len + the utilities) are declared here as native methods on
// `impl String` and dispatch like any named-type method (a String value's type
// name is "String"). Still hand-registered in Rust:
//   * Iterable impls for Range/RangeInclusive (runtime ranges are intrinsic)
//   * the `T[]::len` array pattern method (a receiver shape, not a named type)

// ── Core sum types ──────────────────────────────────────────────────────────

pub enum Perhaps<T> {
    Some { pub value: T },
    None,
}

impl Perhaps<T> {
    // True when this is `Some`.
    pub fun is_some(self) -> boolean {
        match self {
            Perhaps::Some { value } => true,
            _ => false,
        }
    }
    // True when this is `None`.
    pub fun is_none(self) -> boolean {
        match self {
            Perhaps::Some { value } => false,
            _ => true,
        }
    }
    // Transform the contained value, leaving `None` untouched.
    pub fun map<U>(self, f: (T) -> U) -> Perhaps<U> {
        match self {
            Perhaps::Some { value } => Perhaps::Some { value: f(value) },
            _ => Perhaps::None,
        }
    }
    // Chain a computation that itself returns a `Perhaps`.
    pub fun and_then<U>(self, f: (T) -> Perhaps<U>) -> Perhaps<U> {
        match self {
            Perhaps::Some { value } => f(value),
            _ => Perhaps::None,
        }
    }
    // The contained value, or `fallback` when `None`.
    pub fun unwrap_or(self, fallback: T) -> T {
        match self {
            Perhaps::Some { value } => value,
            _ => fallback,
        }
    }
    // The contained value, or the result of `f()` when `None`.
    pub fun unwrap_or_else(self, f: () -> T) -> T {
        match self {
            Perhaps::Some { value } => value,
            _ => f(),
        }
    }
    // The contained value, or panics on `None`. Use only when `None` represents a
    // logic error that should never occur in correct code — prefer `match` or
    // `.unwrap_or`/`.unwrap_or_else` for expected absence.
    pub fun yolo(self) -> T {
        match self {
            Perhaps::Some { value } => value,
            _ => yolo_none::<T>(),
        }
    }
    // Converts to `Result<T, E>`: `Some { value }` becomes `Ok { value }`; `None`
    // becomes `Err { error }`.
    pub fun ok_or<E>(self, error: E) -> Result<T, E> {
        match self {
            Perhaps::Some { value } => Result::Ok { value: value },
            _ => Result::Err { error: error },
        }
    }
}

pub enum Result<T, E> {
    Ok { pub value: T },
    Err { pub error: E },
}

impl Result<T, E> {
    // True when this is `Ok`.
    pub fun is_ok(self) -> boolean {
        match self {
            Result::Ok { value } => true,
            _ => false,
        }
    }
    // True when this is `Err`.
    pub fun is_err(self) -> boolean {
        match self {
            Result::Ok { value } => false,
            _ => true,
        }
    }
    // Transform the success value, leaving `Err` untouched.
    pub fun map<U>(self, f: (T) -> U) -> Result<U, E> {
        match self {
            Result::Ok { value } => Result::Ok { value: f(value) },
            Result::Err { error } => Result::Err { error: error },
        }
    }
    // Chain a computation that itself returns a `Result`.
    pub fun and_then<U>(self, f: (T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok { value } => f(value),
            Result::Err { error } => Result::Err { error: error },
        }
    }
    // The success value, or `fallback` when `Err`.
    pub fun unwrap_or(self, fallback: T) -> T {
        match self {
            Result::Ok { value } => value,
            _ => fallback,
        }
    }
    // The success value, or the result of `f()` when `Err`.
    pub fun unwrap_or_else(self, f: () -> T) -> T {
        match self {
            Result::Ok { value } => value,
            _ => f(),
        }
    }
    // The success value, or panics on `Err`, including the error's debug
    // representation in the panic message. Use only when `Err` represents a
    // logic error — propagate expected errors with `?` or handle with `match`.
    pub fun yolo(self) -> T {
        match self {
            Result::Ok { value } => value,
            Result::Err { error } => yolo_err::<T, E>(error),
        }
    }
    // Applies `f` to the `Err` value, leaving `Ok` unchanged. Useful for
    // converting between error types.
    pub fun map_err<F>(self, f: (E) -> F) -> Result<T, F> {
        match self {
            Result::Ok { value } => Result::Ok { value: value },
            Result::Err { error } => Result::Err { error: f(error) },
        }
    }
    // Converts to `Perhaps<T>`: `Ok { value }` becomes `Some { value }`; `Err`
    // becomes `None`. The error value is discarded.
    pub fun ok(self) -> Perhaps<T> {
        match self {
            Result::Ok { value } => Perhaps::Some { value: value },
            _ => Perhaps::None,
        }
    }
}

// ── Host error type ─────────────────────────────────────────────────────────
// The error type returned by the host-backed std modules (std::fs, std::process,
// …). It carries a human-readable message and implements Display; richer
// structured fields are a deliberate future extension (RFC-0057). It lives in
// std::core so every host module returns the same `Result<T, OsError>`.

pub struct OsError {
    message: String,
}

impl OsError {
    // The human-readable description of the error.
    pub fun message(&self) -> String {
        self.message
    }
}

impl Display for OsError {
    fun to_string(&self) -> String {
        self.message
    }
}

// ── Core aspects ────────────────────────────────────────────────────────────

pub aspect Display {
    fun to_string(&self) -> String;
}

pub aspect From<S> {
    fun from(x: S) -> Self;
}

pub aspect Iterable<T> {
    fun next(&mut self) -> Perhaps<T>;
}

// ── List<T> ─────────────────────────────────────────────────────────────────
// The growable collection type. `inner` is private: the backing array is an
// implementation detail of the host representation.

pub struct List<T> {
    inner: T[],
}

impl List<T> {
    native(@std.core.list_new)      fun new() -> List<T>;
    native(@std.core.list_from)     fun from(src: T[]) -> List<T>;
    native(@std.core.list_push)     fun push(&mut self, x: T);
    native(@std.core.list_pop)      fun pop(&mut self) -> Perhaps<T>;
    native(@std.core.list_len)      fun len(self) -> i64;
    native(@std.core.list_get)      fun get(self, i: i64) -> Perhaps<T>;
    native(@std.core.list_as_slice) fun as_slice(self) -> T[];

    // ── Ergonomics (METEL-160) ──────────────────────────────────────────────
    // Eager transforms over the backing array. A lazy iterator layer is a
    // deferred follow-up (RFC-0057); these favour usefulness over a final
    // iterator architecture.

    // Apply `f` to each element, collecting the results into a new list.
    pub fun map<U>(self, f: (T) -> U) -> List<U> {
        let mut out: List<U> = List::new();
        for (let x in self.as_slice()) {
            out.push(f(x));
        }
        out
    }
    // Keep only the elements for which `pred` holds.
    pub fun filter(self, pred: (T) -> boolean) -> List<T> {
        let mut out: List<T> = List::new();
        for (let x in self.as_slice()) {
            if (pred(x)) {
                out.push(x);
            }
        }
        out
    }
    // Reduce the list to a single value, left to right.
    pub fun fold<A>(self, init: A, f: (A, T) -> A) -> A {
        let mut acc = init;
        for (let x in self.as_slice()) {
            acc = f(acc, x);
        }
        acc
    }
    // The first element satisfying `pred`, or `None`.
    pub fun find(self, pred: (T) -> boolean) -> Perhaps<T> {
        for (let x in self.as_slice()) {
            if (pred(x)) {
                return Perhaps::Some { value: x };
            }
        }
        Perhaps::None
    }
    // A new list with this list's elements followed by `other`'s.
    pub fun concat(self, other: List<T>) -> List<T> {
        let mut out: List<T> = List::new();
        for (let x in self.as_slice()) {
            out.push(x);
        }
        for (let y in other.as_slice()) {
            out.push(y);
        }
        out
    }
}

// ── String methods ──────────────────────────────────────────────────────────

impl String {
    // Number of characters (Unicode scalar values), not bytes. All index-based
    // string operations below are likewise in Unicode scalars, and are total:
    // out-of-range indices clamp or yield `None` rather than panicking.
    native(@std.core.string_len) fun len(self) -> i64;

    // ── Case & trim ─────────────────────────────────────────────────────────
    native(@std.core.string_to_upper)   fun to_upper(self) -> String;
    native(@std.core.string_to_lower)   fun to_lower(self) -> String;
    native(@std.core.string_trim)       fun trim(self) -> String;
    native(@std.core.string_trim_start) fun trim_start(self) -> String;
    native(@std.core.string_trim_end)   fun trim_end(self) -> String;
    // True when the string has no characters.
    native(@std.core.string_is_empty)   fun is_empty(self) -> boolean;

    // ── Search & test ───────────────────────────────────────────────────────
    native(@std.core.string_contains)    fun contains(self, needle: String) -> boolean;
    native(@std.core.string_starts_with) fun starts_with(self, prefix: String) -> boolean;
    native(@std.core.string_ends_with)   fun ends_with(self, suffix: String) -> boolean;
    // Scalar index of the first occurrence of `needle`, or `None`.
    native(@std.core.string_index_of)    fun index_of(self, needle: String) -> Perhaps<i64>;

    // ── Split, join, replace ────────────────────────────────────────────────
    // Split on every occurrence of `sep`. An empty `sep` yields the whole string.
    native(@std.core.string_split)   fun split(self, sep: String) -> String[];
    native(@std.core.string_replace) fun replace(self, from: String, to: String) -> String;
    // Repeat the string `n` times (`n <= 0` yields the empty string).
    native(@std.core.string_repeat)  fun repeat(self, n: i64) -> String;
    // Concatenate `parts` with `sep` between each element.
    native(@std.core.string_join)    fun join(parts: String[], sep: String) -> String;

    // ── Chars & slicing ─────────────────────────────────────────────────────
    native(@std.core.string_chars)     fun chars(self) -> Char[];
    // The character at scalar index `i`, or `None` if out of range.
    native(@std.core.string_char_at)   fun char_at(self, i: i64) -> Perhaps<Char>;
    // The substring over the scalar range [start, end), with indices clamped.
    native(@std.core.string_substring) fun substring(self, start: i64, end: i64) -> String;
}

// ── Free functions ──────────────────────────────────────────────────────────

// print/println are generic over any Displayable value. Display dispatch happens
// in-language via `x.to_string()` (the host fn has no runtime handle to dispatch
// a user `Display` impl — METEL-192), so the host helpers below only ever
// receive an already-formatted String.
native(@std.core.print)      fun print_str(s: String);
native(@std.core.println)    fun println_str(s: String);

pub fun print<T: Display>(x: T) -> () {
    print_str(x.to_string());
}

pub fun println<T: Display>(x: T) -> () {
    println_str(x.to_string());
}

native(@std.core.dbg)        pub fun dbg<T>(x: T) -> T;
// assert is overloaded: with and without a panic message.
native(@std.core.assert)     pub fun assert(cond: boolean);
native(@std.core.assert_msg) pub fun assert(cond: boolean, msg: String);
native(@std.core.clock)      pub fun clock() -> i64;

// `.yolo()`'s two panicking arms (issue #232). Both always panic — there is no
// well-typed "success" case. Callers must supply generics via turbofish
// (e.g. `yolo_none::<T>()`); unlike enum variant construction, a generic function
// call's return type doesn't get inferred from surrounding match-arm unification.
native(@std.core.yolo_none) fun yolo_none<T>() -> T;
native(@std.core.yolo_err)  fun yolo_err<T, E>(error: E) -> T;

// ── Display impls for the primitive types ──────────────────────────────────
// One shared host implementation formats any displayable value, so every
// impl binds to the same @std.core.to_string key.

impl Display for i8 {
    native(@std.core.to_string) fun to_string(&self) -> String;
}

impl Display for i16 {
    native(@std.core.to_string) fun to_string(&self) -> String;
}

impl Display for i32 {
    native(@std.core.to_string) fun to_string(&self) -> String;
}

impl Display for i64 {
